# 공통
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bizagent
POSTGRES_USER=bizagent
POSTGRES_PASSWORD=changeme

# ai-engine
ANTHROPIC_API_KEY=
MOCK_LLM=false         # true면 Claude 호출 없이 각 서비스가 목업 데이터를 반환 (토큰 절약용 테스트 스위치)
CHROMA_HOST=localhost
CHROMA_PORT=8001
ECOS_API_KEY=          # 한국은행 경기지표
BIZINFO_CRTFC_KEY=     # 기업마당 정책자금

# api-core
AI_ENGINE_BASE_URL=http://localhost:8000
KAKAO_CLIENT_ID=      # 카카오 "나에게 보내기" 알림 (선택 — 없으면 인앱 알림만 동작)
KAKAO_CLIENT_SECRET=  # 카카오 콘솔에서 client_secret 미활성 시 빈 값으로 둬도 됨
KAKAO_REDIRECT_URI=http://localhost:8080/api/kakao/oauth/callback

# web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
